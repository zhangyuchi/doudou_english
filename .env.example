# 复制为 .env.local，仅供本机生成脚本读取；不要使用 VITE_ 前缀。
ALIYUN_NLS_APPKEY=
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=

# 可选：从控制台获取的临时 NLS Token，填写后优先使用；过期需更换。
ALIYUN_NLS_TOKEN=

# 精品英音：百炼华北2（北京）的 API Key，与上方 NLS Token 不同。
# 获取：https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=

# 百炼北京业务空间 ID（Workspace ID），用于构造请求域名。
# 获取：https://help.aliyun.com/zh/model-studio/obtain-the-app-id-and-workspace-id
DASHSCOPE_WORKSPACE_ID=
